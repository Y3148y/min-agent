# ---------------------------------------------------------------------------
# Copy to .env and fill in. Any Anthropic-compatible endpoint works, because
# the agent speaks the Anthropic Messages protocol (native tool_use blocks).
# ---------------------------------------------------------------------------

# API key. On third-party gateways this is often a gateway token rather than a
# first-party Anthropic key; DashScope's Anthropic-compatible route accepts the
# DashScope key here.
ANTHROPIC_API_KEY=sk-xxxxxxxxxxxxxxxx

# Leave empty for the official api.anthropic.com. Set it for any compatible
# gateway, e.g. https://dashscope.aliyuncs.com/apps/anthropic
ANTHROPIC_BASE_URL=

# Any model that supports tool use on your endpoint.
MODEL_ID=qwen3.7-flash-2026-07-15

# --- Agent loop limits -------------------------------------------------
# Max tool-use iterations for ONE user turn, before we force a wrap-up.
MAX_TURNS=12
# Stop the loop if the model repeats the same tool+args this many times in a row.
MAX_REPEAT_CALL=3
# Per-tool wall-clock budget in seconds.
TOOL_TIMEOUT=10
# Largest tool result (in characters) that is fed back into the context.
MAX_TOOL_RESULT_CHARS=2000

# weather backend:
#   mock     deterministic fake forecast (default, fully offline)
#   wttr.in  real forecast from https://wttr.in -- no API key needed;
#            falls back to mock when the service is unreachable
WEATHER_BACKEND=mock

# --- Context management ----------------------------------------------
# Approximate token budget for a single request. Compaction starts when the
# estimate crosses this.
CONTEXT_BUDGET=24000
# Messages at the tail that are always kept verbatim through compaction.
KEEP_RECENT_MESSAGES=6
# Longest summary (in characters) the compaction prompt is allowed to produce.
SUMMARY_MAX_CHARS=800

# --- Memory ------------------------------------------------------------
# How many long-term memories may be injected into the system prompt per turn.
MEMORY_TOP_K=5
# Memories older than this many days stop being recalled (they are archived,
# not deleted).
MEMORY_TTL_DAYS=90
